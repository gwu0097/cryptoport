NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The anon/public key (Supabase dashboard: Settings -> API) — used for the
# per-user, RLS-enforced client (see src/lib/supabase.ts's userDb()/userAuth()).
# Safe to be public: security comes from RLS policies, not from hiding this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute base URL this app is served from — needed to build auth email
# links (signup confirmation, password reset), which have to be full URLs.
# Set to the real production domain in Vercel; localhost is fine for dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The one account allowed to see /admin (src/lib/adminAuth.ts) — a plain
# email compared server-side against the signed-in user, same convention as
# CRON_SECRET. Leave unset to disable /admin entirely.
ADMIN_EMAIL=

# Free tier (dashboard.alchemy.com) — used by alchemy.ts as the preferred
# transaction-history source for chains where Blockscout/Etherscan have
# proven unreliable (currently just Base). Leave unset and those chains
# fall back to Blockscout.
ALCHEMY_API_KEY=
